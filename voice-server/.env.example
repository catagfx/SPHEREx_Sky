# LiveKit Cloud project (livekit.io > Settings > Keys). The secret stays on the server only.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

VOICE_PORT=8787
# Where the site lives: used for invite links
PUBLIC_URL=http://localhost:5173
# Extra allowed browser origins (comma separated), e.g. https://sky.example.com. localhost is always allowed.
ALLOWED_ORIGINS=
# Set to 1 when accessed through the Vite or Python proxy (direct public access must be blocked).
VOICE_TRUST_PROXY=0
