{
  "name": "spherex-sky",
  "private": true,
  "version": "1.0.0",
  "license": "(MIT OR Apache-2.0 OR GPL-3.0-or-later)",
  "description": "SPHEREx Sky: Python backend (backend/) + one Vite bundle (ui/src: React intro & story, the 3D viewer). `npm run dev` starts both.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vr": "node scripts/dev.mjs --vr",
    "build": "vite build",
    "build:pages": "node scripts/build-site.mjs",
    "typecheck": "tsc --noEmit",
    "start": "python server.py",
    "voice": "node voice-server/server.js",
    "test:voice": "node voice-server/test.mjs",
    "test:voice:presence": "node tests/voice-presence.mjs",
    "test": "node tests/e2e.mjs && node tests/behaviour.mjs && node tests/intro.mjs && node tests/animations.mjs && node tests/vr.mjs",
    "test:e2e": "node tests/e2e.mjs",
    "test:behaviour": "node tests/behaviour.mjs",
    "test:intro": "node tests/intro.mjs",
    "test:animations": "node tests/animations.mjs",
    "test:vr": "node tests/vr.mjs",
    "snapshot:save": "node tests/snapshot-render.mjs save && node tests/snapshot-styles.mjs save",
    "snapshot:compare": "node tests/snapshot-render.mjs compare && node tests/snapshot-styles.mjs compare"
  },
  "dependencies": {
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "livekit-client": "^2.24.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "0.128.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "iwer": "^2.8.0",
    "playwright": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  }
}
