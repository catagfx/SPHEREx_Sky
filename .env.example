# SPHEREx Sky — Local Environment Configuration
# Copy this file to .env and fill in values if you want optional email delivery.
# Never commit .env to Git!

# Server Port & Host
PORT=8080
IRSA_TAP_TIMEOUT=25.0

# Optional Outgoing SMTP Relay (e.g., Gmail with a 16-char Google App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
